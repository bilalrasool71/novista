# ---------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------

# Canonical origin, no trailing slash. Used for metadata, sitemap,
# robots.txt and JSON-LD. Falls back to https://novista.io.
NEXT_PUBLIC_SITE_URL=https://novista.io

# --- Contact form delivery -------------------------------------
# The form works with none of these set (submissions are logged to the
# server console). Configure one of the two options below for production.

# Option A - email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@novista.io
CONTACT_FROM_EMAIL=website@novista.io

# Option B - POST the submission as JSON to any endpoint
# (Zapier, Make, n8n, Slack workflow, your own CRM).
CONTACT_WEBHOOK_URL=

# --- Analytics (optional) --------------------------------------
# Leave blank to ship no tracking at all.
NEXT_PUBLIC_GA_ID=

# --- Search Console (optional) ---------------------------------
# The token from the "HTML tag" verification method.
GOOGLE_SITE_VERIFICATION=
